{
  "name": "giantbombtv-webos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "package": "npm run build && ares-package dist -o build",
    "install-tv": "ares-install --device tv build/*.ipk",
    "launch-tv": "ares-launch --device tv com.giantbomb.tv.webos"
  },
  "dependencies": {
    "@noriginmedia/norigin-spatial-navigation": "^2.2.2",
    "@tanstack/react-query": "^5.59.0",
    "hls.js": "^1.5.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
